<Window x:Class="HYBurningStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HY Burning Studio" Icon="Assets/HY-Burning-Studio.ico" Width="1120" Height="720" MinWidth="900" MinHeight="620"
        Background="{DynamicResource ThemeBackground}" FontFamily="Segoe UI" Foreground="{DynamicResource ThemeText}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#286BEF"/>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource ThemeHint}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource ThemeCard}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ThemeCard}"/><Setter Property="Foreground" Value="{DynamicResource ThemeButtonText}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#286BEF"/><Setter Property="BorderBrush" Value="#286BEF"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="14,11"/></Style>

    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeCard}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeNavSelected}"/><Setter Property="Foreground" Value="{DynamicResource ThemeNavSelectedText}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,7"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeInput}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="6"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="10,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource ThemeText}" StrokeThickness="1.3" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListView"><Setter Property="Background" Value="{DynamicResource ThemeCard}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Style><Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="{DynamicResource ThemeInput}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/><Setter Property="Background" Value="{DynamicResource ThemeInput}"/></Style>
  </Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Background="{DynamicResource ThemeSidebar}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="22,24,18,24"><DockPanel><Image Source="Assets/HY-Burning-Studio-Logo.png" Width="36" Height="36" Margin="0,0,12,0" Stretch="Uniform"/><StackPanel><TextBlock Text="HY Burning" FontSize="16" FontWeight="Bold"/><TextBlock Text="STUDIO" FontSize="10" Foreground="{DynamicResource ThemeHint}" FontWeight="Bold"/></StackPanel></DockPanel><Border Background="{DynamicResource ThemeSeparator}" Height="1" Margin="0,20,0,0"/></StackPanel>
      <StackPanel Grid.Row="1" Margin="14,0"><Button x:Name="HomeNav" Content="01    Beranda" Style="{StaticResource Nav}" Click="Home_Click"/><Button x:Name="DataNav" Content="02    Data Disc" Style="{StaticResource Nav}" Click="Data_Click"/><Button x:Name="AudioNav" Content="03    Audio CD" Style="{StaticResource Nav}" Click="Audio_Click"/><Button x:Name="IsoNav" Content="04    Burn ISO" Style="{StaticResource Nav}" Click="Iso_Click"/><Button x:Name="SettingsNav" Content="05    Pengaturan" Style="{StaticResource Nav}" Click="Settings_Click"/><Border Height="1" Background="{DynamicResource ThemeSeparator}" Margin="8,14,8,8"/><Button x:Name="OpenProjectButton" Content="Buka proyek..." Click="OpenSavedProject_Click" Margin="0,3"/><Button x:Name="SaveProjectButton" Content="Simpan proyek..." Click="SaveProject_Click" Margin="0,3"/></StackPanel>
      <Border Grid.Row="2" Margin="16" Background="{DynamicResource ThemeCard}" CornerRadius="14" Padding="14"><StackPanel><TextBlock Text="STATUS DRIVE" Foreground="{DynamicResource ThemeGreen}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DriveStatus" Text="Memeriksa drive..." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/><Button x:Name="RefreshDriveButton" Content="Perbarui drive" Click="RefreshDrives_Click" Padding="4,5" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
    <Grid Grid.Column="1" Margin="32,24,32,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="Breadcrumb" Text="BERANDA  /  MULAI" FontSize="11" Foreground="{DynamicResource ThemeHint}" Margin="0,0,0,22"/>
      <Grid Grid.Row="1">
        <Grid x:Name="HomePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Halo, selamat datang." Style="{StaticResource Title}"/><TextBlock Text="Apa yang ingin Anda buat hari ini?" Style="{StaticResource Hint}"/></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,26,0,20"><StackPanel><TextBlock Text="Semua yang Anda butuhkan, dalam satu tempat." FontSize="17" FontWeight="Bold"/><TextBlock Text="Buat disc data, susun Audio CD, atau bakar file ISO dengan mudah." Style="{StaticResource Hint}" Margin="0,8,0,0"/><TextBlock Text="SEPENUHNYA OFFLINE" FontSize="10" Foreground="{DynamicResource ThemeAccentText}" FontWeight="Bold" Margin="0,14,0,0"/></StackPanel></Border>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Margin="0,0,8,0" Click="Data_Click" Padding="0" HorizontalContentAlignment="Stretch"><StackPanel Margin="18"><TextBlock Text="DATA" Foreground="{DynamicResource ThemeAccentText}" FontWeight="Bold"/><TextBlock Text="Data Disc" FontSize="19" FontWeight="Bold" Margin="0,25,0,4"/><TextBlock Text="Simpan file dan folder" Style="{StaticResource Hint}"/><TextBlock Text="CD &amp; DVD   →" Foreground="{DynamicResource ThemeAccentText}" FontSize="11" Margin="0,25,0,0"/></StackPanel></Button><Button Grid.Column="1" Margin="4,0" Click="Audio_Click" Padding="0"><StackPanel Margin="18"><TextBlock Text="MUSIK" Foreground="{DynamicResource ThemePurple}" FontWeight="Bold"/><TextBlock Text="Audio CD" FontSize="19" FontWeight="Bold" Margin="0,25,0,4"/><TextBlock Text="Buat CD musik" Style="{StaticResource Hint}"/><TextBlock Text="MP3 · WAV · FLAC   →" Foreground="{DynamicResource ThemePurple}" FontSize="11" Margin="0,25,0,0"/></StackPanel></Button><Button Grid.Column="2" Margin="8,0,0,0" Click="Iso_Click" Padding="0"><StackPanel Margin="18"><TextBlock Text="ISO" Foreground="{DynamicResource ThemeGreen}" FontWeight="Bold"/><TextBlock Text="Burn ISO" FontSize="19" FontWeight="Bold" Margin="0,25,0,4"/><TextBlock Text="Tulis image ke disc" Style="{StaticResource Hint}"/><TextBlock Text="CD &amp; DVD   →" Foreground="{DynamicResource ThemeGreen}" FontSize="11" Margin="0,25,0,0"/></StackPanel></Button></Grid>
          <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,20,0,0"><StackPanel><TextBlock Text="DRIVE TERHUBUNG" FontSize="10" Foreground="{DynamicResource ThemeHint}" FontWeight="Bold"/><TextBlock x:Name="HomeDrive" Text="Tidak ada drive" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
        <Grid x:Name="ProjectPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="ProjectTitle" Text="Data Disc" Style="{StaticResource Title}"/><TextBlock x:Name="ProjectHint" Style="{StaticResource Hint}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="AddFileButton" Content="+ Tambah file" Style="{StaticResource Primary}" Click="AddFile_Click"/><Button x:Name="AddFolderButton" Content="+ Folder" Margin="8,0,0,0" Click="AddFolder_Click"/></StackPanel></DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Content="Hapus" Click="RemoveItem_Click"/><Button x:Name="MoveUpButton" Content="Naik" Click="MoveUp_Click" Margin="8,0,0,0"/><Button x:Name="MoveDownButton" Content="Turun" Click="MoveDown_Click" Margin="8,0,0,0"/><Button x:Name="PreviewAudioButton" Content="▶ Dengarkan" Click="PreviewAudio_Click" Margin="8,0,0,0"/><Button x:Name="StopPreviewButton" Content="■ Hentikan" Click="StopPreview_Click" Margin="8,0,0,0"/></StackPanel><ListView x:Name="ItemsList" BorderThickness="0" AllowDrop="True" Drop="ItemsList_Drop" SelectionChanged="AudioSelectionChanged"><ListView.View><GridView><GridViewColumn Header="NAMA" Width="300" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="JENIS" Width="115" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="UKURAN / DURASI" Width="145" DisplayMemberBinding="{Binding Detail}"/></GridView></ListView.View></ListView></DockPanel></Border>
          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,14" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="VolumePanel" Margin="0,0,12,0"><TextBlock Text="Nama disc" Style="{StaticResource Hint}" Margin="0,0,0,5"/><TextBox x:Name="VolumeName" Text="HY_BURNING" MaxLength="32"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Drive tujuan" Style="{StaticResource Hint}" Margin="0,0,0,5"/><ComboBox x:Name="DrivePicker" DisplayMemberPath="Name" SelectionChanged="DrivePicker_SelectionChanged"/></StackPanel></Grid></Border>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,30,0"><TextBlock x:Name="CapacityText" Text="Pilih disc untuk melihat kapasitas" FontWeight="SemiBold" FontSize="12"/><ProgressBar x:Name="CapacityBar" Height="8" Maximum="100" Value="0" Margin="0,8,0,0" Foreground="#3476F3"/></StackPanel><Button Grid.Column="1" Content="Lanjutkan  →" Style="{StaticResource Primary}" Click="Review_Click"/></Grid>
        </Grid>
        <Grid x:Name="IsoPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Burn ISO" Style="{StaticResource Title}"/><TextBlock Text="Tulis file image langsung ke CD atau DVD." Style="{StaticResource Hint}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,25,0,20" AllowDrop="True" Drop="Iso_Drop"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="ISO" FontSize="24" Foreground="{DynamicResource ThemeAccentText}" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="IsoName" Text="Pilih file ISO" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,4" TextWrapping="Wrap"/><TextBlock x:Name="IsoHint" Text="Seret file ke sini atau pilih dari komputer" Style="{StaticResource Hint}" HorizontalAlignment="Center"/><Button Content="Pilih file ISO" HorizontalAlignment="Center" Click="SelectIso_Click" Margin="0,20,0,0"/><Button Content="Buat ISO dari file atau disc..." HorizontalAlignment="Center" Click="CreateIso_Click" Margin="0,10,0,0"/></StackPanel></Border><Button Grid.Row="2" HorizontalAlignment="Right" Content="Lanjutkan  →" Style="{StaticResource Primary}" Click="Review_Click"/></Grid>
        <Grid x:Name="ReviewPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Tinjau sebelum burning" Style="{StaticResource Title}"/><TextBlock Text="Pastikan disc dan pengaturan sudah sesuai." Style="{StaticResource Hint}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,16"><StackPanel><TextBlock Text="RINGKASAN PROYEK" FontSize="10" Foreground="{DynamicResource ThemeHint}" FontWeight="Bold"/><TextBlock x:Name="ReviewSummary" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ReviewMedia" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Pengaturan burning" FontSize="16" FontWeight="Bold"/><TextBlock Text="Drive tujuan" Style="{StaticResource Hint}" Margin="0,16,0,5"/><ComboBox x:Name="ReviewDrivePicker" DisplayMemberPath="Name" SelectionChanged="ReviewDrivePicker_SelectionChanged"/><TextBlock Text="Kecepatan penulisan" Style="{StaticResource Hint}" Margin="0,14,0,5"/><ComboBox x:Name="SpeedPicker" DisplayMemberPath="Label"/><TextBlock x:Name="SpeedHint" Style="{StaticResource Hint}" Margin="0,5,0,8" TextWrapping="Wrap"/><CheckBox x:Name="VerifyCheck" Content="Verifikasi setelah burning" IsChecked="True" Margin="0,5"/><TextBlock x:Name="VerifyHint" Style="{StaticResource Hint}" Margin="20,0,0,4"/><CheckBox x:Name="EjectCheck" Content="Keluarkan disc setelah selesai" Margin="0,8"/></StackPanel></Border><DockPanel Grid.Row="3" Margin="0,20,0,0"><Button Content="←  Kembali" DockPanel.Dock="Left" Click="Back_Click"/><Button Content="Mulai burning" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Burn_Click"/></DockPanel></Grid>
        <Grid x:Name="ProgressPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Proses burning" Style="{StaticResource Title}"/><TextBlock Text="Mohon tunggu hingga proses selesai." Style="{StaticResource Hint}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,0" VerticalAlignment="Top"><StackPanel><TextBlock x:Name="ProgressStatus" Text="Mempersiapkan..." FontSize="20" FontWeight="Bold"/><TextBlock x:Name="ProgressDetails" Style="{StaticResource Hint}" Margin="0,12,0,24"/><ProgressBar x:Name="BurnProgressBar" Height="10" IsIndeterminate="True" Foreground="#3476F3"/><Button x:Name="ProgressDone" Content="Kembali ke beranda" Click="Home_Click" Margin="0,25,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/></StackPanel></Border></Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Pengaturan" Style="{StaticResource Title}"/><TextBlock Text="Sesuaikan pengalaman HY Burning Studio." Style="{StaticResource Hint}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,0" VerticalAlignment="Top"><StackPanel><TextBlock Text="UMUM" FontSize="10" Foreground="{DynamicResource ThemeHint}" FontWeight="Bold"/><TextBlock Text="Bahasa: Indonesia" FontWeight="SemiBold" Margin="0,20,0,0"/><TextBlock Text="Tampilan" FontWeight="SemiBold" Margin="0,18,0,5"/><ComboBox x:Name="ThemePicker" SelectionChanged="ThemePicker_SelectionChanged" Width="200" HorizontalAlignment="Left"><ComboBoxItem Content="Terang"/><ComboBoxItem Content="Gelap"/></ComboBox><TextBlock Text="Kecepatan burning dipilih saat meninjau proyek" Margin="0,18,0,0"/><TextBlock Text="Disc yang dapat ditulis ulang" FontWeight="SemiBold" Margin="0,30,0,5"/><TextBlock Text="Hapus isi CD-RW atau DVD-RW pada drive yang dipilih." Style="{StaticResource Hint}"/><ComboBox x:Name="EraseDrivePicker" DisplayMemberPath="Name" Margin="0,12,0,8"/><Button Content="Hapus disc yang dapat ditulis ulang" HorizontalAlignment="Left" Click="Erase_Click"/><TextBlock Text="HY Burning Studio · Aplikasi offline untuk Windows" Style="{StaticResource Hint}" Margin="0,30,0,0"/></StackPanel></Border></Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>

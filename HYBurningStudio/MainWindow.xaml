<Window x:Class="HYBurningStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HY Burning Studio" Width="1120" Height="720" MinWidth="900" MinHeight="620"
        Background="#F4F6FA" FontFamily="Segoe UI" Foreground="#17243D" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#286BEF"/>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#75859C"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="#E6EBF2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#40516C"/><Setter Property="BorderBrush" Value="#DFE6F0"/><Setter Property="Padding" Value="15,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#286BEF"/><Setter Property="BorderBrush" Value="#286BEF"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="14,11"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#E2E8F2"/><Setter Property="Background" Value="#F7F9FC"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#F7F9FC"/><Setter Property="BorderBrush" Value="#E2E8F2"/></Style>
  </Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Background="#EDF1F7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="22,24,18,24"><DockPanel><Border Background="#286BEF" CornerRadius="12" Width="36" Height="36" Margin="0,0,12,0"><TextBlock Text="H" FontWeight="Bold" FontSize="19" Foreground="White" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="HY Burning" FontSize="16" FontWeight="Bold"/><TextBlock Text="STUDIO" FontSize="10" Foreground="#7C8AA1" FontWeight="Bold"/></StackPanel></DockPanel><Border Background="#DCE3ED" Height="1" Margin="0,20,0,0"/></StackPanel>
      <StackPanel Grid.Row="1" Margin="14,0"><Button x:Name="HomeNav" Content="01    Beranda" Style="{StaticResource Nav}" Click="Home_Click"/><Button x:Name="DataNav" Content="02    Data Disc" Style="{StaticResource Nav}" Click="Data_Click"/><Button x:Name="AudioNav" Content="03    Audio CD" Style="{StaticResource Nav}" Click="Audio_Click"/><Button x:Name="IsoNav" Content="04    Burn ISO" Style="{StaticResource Nav}" Click="Iso_Click"/><Button x:Name="SettingsNav" Content="05    Pengaturan" Style="{StaticResource Nav}" Click="Settings_Click"/></StackPanel>
      <Border Grid.Row="2" Margin="16" Background="White" CornerRadius="14" Padding="14"><StackPanel><TextBlock Text="STATUS DRIVE" Foreground="#45A57A" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DriveStatus" Text="Memeriksa drive..." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/><Button x:Name="RefreshDriveButton" Content="Perbarui drive" Click="RefreshDrives_Click" Padding="4,5" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
    <Grid Grid.Column="1" Margin="32,24,32,25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="Breadcrumb" Text="BERANDA  /  MULAI" FontSize="11" Foreground="#8794A8" Margin="0,0,0,22"/>
      <Grid Grid.Row="1">
        <Grid x:Name="HomePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="Halo, selamat datang." Style="{StaticResource Title}"/><TextBlock Text="Apa yang ingin Anda buat hari ini?" Style="{StaticResource Hint}"/></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,26,0,20"><StackPanel><TextBlock Text="Semua yang Anda butuhkan, dalam satu tempat." FontSize="17" FontWeight="Bold"/><TextBlock Text="Buat disc data, susun Audio CD, atau bakar file ISO dengan mudah." Style="{StaticResource Hint}" Margin="0,8,0,0"/><TextBlock Text="SEPENUHNYA OFFLINE" FontSize="10" Foreground="#286BEF" FontWeight="Bold" Margin="0,14,0,0"/></StackPanel></Border>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Margin="0,0,8,0" Click="Data_Click" Padding="0" HorizontalContentAlignment="Stretch"><StackPanel Margin="18"><TextBlock Text="DATA" Foreground="#286BEF" FontWeight="Bold"/><TextBlock Text="Data Disc" FontSize="19" FontWeight="Bold" Margin="0,25,0,4"/><TextBlock Text="Simpan file dan folder" Style="{StaticResource Hint}"/><TextBlock Text="CD &amp; DVD   →" Foreground="#286BEF" FontSize="11" Margin="0,25,0,0"/></StackPanel></Button><Button Grid.Column="1" Margin="4,0" Click="Audio_Click" Padding="0"><StackPanel Margin="18"><TextBlock Text="MUSIK" Foreground="#8B5CD6" FontWeight="Bold"/><TextBlock Text="Audio CD" FontSize="19" FontWeight="Bold" Margin="0,25,0,4"/><TextBlock Text="Buat CD musik" Style="{StaticResource Hint}"/><TextBlock Text="MP3 · WAV · FLAC   →" Foreground="#8B5CD6" FontSize="11" Margin="0,25,0,0"/></StackPanel></Button><Button Grid.Column="2" Margin="8,0,0,0" Click="Iso_Click" Padding="0"><StackPanel Margin="18"><TextBlock Text="ISO" Foreground="#278C78" FontWeight="Bold"/><TextBlock Text="Burn ISO" FontSize="19" FontWeight="Bold" Margin="0,25,0,4"/><TextBlock Text="Tulis image ke disc" Style="{StaticResource Hint}"/><TextBlock Text="CD &amp; DVD   →" Foreground="#278C78" FontSize="11" Margin="0,25,0,0"/></StackPanel></Button></Grid>
          <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,20,0,0"><StackPanel><TextBlock Text="DRIVE TERHUBUNG" FontSize="10" Foreground="#8C9AAF" FontWeight="Bold"/><TextBlock x:Name="HomeDrive" Text="Tidak ada drive" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
        <Grid x:Name="ProjectPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,22"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="ProjectTitle" Text="Data Disc" Style="{StaticResource Title}"/><TextBlock x:Name="ProjectHint" Style="{StaticResource Hint}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="AddFileButton" Content="+ Tambah file" Style="{StaticResource Primary}" Click="AddFile_Click"/><Button x:Name="AddFolderButton" Content="+ Folder" Margin="8,0,0,0" Click="AddFolder_Click"/></StackPanel></DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Content="Hapus" Click="RemoveItem_Click"/><Button x:Name="MoveUpButton" Content="Naik" Click="MoveUp_Click" Margin="8,0,0,0"/><Button x:Name="MoveDownButton" Content="Turun" Click="MoveDown_Click" Margin="8,0,0,0"/></StackPanel><ListView x:Name="ItemsList" BorderThickness="0" AllowDrop="True" Drop="ItemsList_Drop"><ListView.View><GridView><GridViewColumn Header="NAMA" Width="300" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="JENIS" Width="115" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="UKURAN / DURASI" Width="145" DisplayMemberBinding="{Binding Detail}"/></GridView></ListView.View></ListView></DockPanel></Border>
          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,14" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="VolumePanel" Margin="0,0,12,0"><TextBlock Text="Nama disc" Style="{StaticResource Hint}" Margin="0,0,0,5"/><TextBox x:Name="VolumeName" Text="HY_BURNING" MaxLength="32"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Drive tujuan" Style="{StaticResource Hint}" Margin="0,0,0,5"/><ComboBox x:Name="DrivePicker" DisplayMemberPath="Name" SelectionChanged="DrivePicker_SelectionChanged"/></StackPanel></Grid></Border>
          <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,30,0"><TextBlock x:Name="CapacityText" Text="Pilih disc untuk melihat kapasitas" FontWeight="SemiBold" FontSize="12"/><ProgressBar x:Name="CapacityBar" Height="8" Maximum="100" Value="0" Margin="0,8,0,0" Foreground="#3476F3"/></StackPanel><Button Grid.Column="1" Content="Lanjutkan  →" Style="{StaticResource Primary}" Click="Review_Click"/></Grid>
        </Grid>
        <Grid x:Name="IsoPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Burn ISO" Style="{StaticResource Title}"/><TextBlock Text="Tulis file image langsung ke CD atau DVD." Style="{StaticResource Hint}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,25,0,20" AllowDrop="True" Drop="Iso_Drop"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="ISO" FontSize="24" Foreground="#286BEF" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="IsoName" Text="Pilih file ISO" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,4" TextWrapping="Wrap"/><TextBlock x:Name="IsoHint" Text="Seret file ke sini atau pilih dari komputer" Style="{StaticResource Hint}" HorizontalAlignment="Center"/><Button Content="Pilih file ISO" HorizontalAlignment="Center" Click="SelectIso_Click" Margin="0,20,0,0"/></StackPanel></Border><Button Grid.Row="2" HorizontalAlignment="Right" Content="Lanjutkan  →" Style="{StaticResource Primary}" Click="Review_Click"/></Grid>
        <Grid x:Name="ReviewPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Tinjau sebelum burning" Style="{StaticResource Title}"/><TextBlock Text="Pastikan disc dan pengaturan sudah sesuai." Style="{StaticResource Hint}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,16"><StackPanel><TextBlock Text="RINGKASAN PROYEK" FontSize="10" Foreground="#8C9AAF" FontWeight="Bold"/><TextBlock x:Name="ReviewSummary" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ReviewMedia" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border><Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="Pengaturan burning" FontSize="16" FontWeight="Bold"/><TextBlock Text="Drive tujuan" Style="{StaticResource Hint}" Margin="0,16,0,5"/><ComboBox x:Name="ReviewDrivePicker" DisplayMemberPath="Name" SelectionChanged="ReviewDrivePicker_SelectionChanged"/><TextBlock Text="Kecepatan penulisan: otomatis" Margin="0,14,0,12"/><CheckBox x:Name="VerifyCheck" Content="Verifikasi setelah burning" IsChecked="True" Margin="0,5"/><TextBlock x:Name="VerifyHint" Style="{StaticResource Hint}" Margin="20,0,0,4"/><CheckBox x:Name="EjectCheck" Content="Keluarkan disc setelah selesai" Margin="0,8"/></StackPanel></Border><DockPanel Grid.Row="3" Margin="0,20,0,0"><Button Content="←  Kembali" DockPanel.Dock="Left" Click="Back_Click"/><Button Content="Mulai burning" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Burn_Click"/></DockPanel></Grid>
        <Grid x:Name="ProgressPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Proses burning" Style="{StaticResource Title}"/><TextBlock Text="Mohon tunggu hingga proses selesai." Style="{StaticResource Hint}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,0" VerticalAlignment="Top"><StackPanel><TextBlock x:Name="ProgressStatus" Text="Mempersiapkan..." FontSize="20" FontWeight="Bold"/><TextBlock x:Name="ProgressDetails" Style="{StaticResource Hint}" Margin="0,12,0,24"/><ProgressBar x:Name="BurnProgressBar" Height="10" IsIndeterminate="True" Foreground="#3476F3"/><Button x:Name="ProgressDone" Content="Kembali ke beranda" Click="Home_Click" Margin="0,25,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/></StackPanel></Border></Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Pengaturan" Style="{StaticResource Title}"/><TextBlock Text="Sesuaikan pengalaman HY Burning Studio." Style="{StaticResource Hint}"/></StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,0" VerticalAlignment="Top"><StackPanel><TextBlock Text="UMUM" FontSize="10" Foreground="#8C9AAF" FontWeight="Bold"/><TextBlock Text="Bahasa: Indonesia" FontWeight="SemiBold" Margin="0,20,0,0"/><TextBlock Text="Kecepatan burning: otomatis" Margin="0,18,0,0"/><TextBlock Text="Disc yang dapat ditulis ulang" FontWeight="SemiBold" Margin="0,30,0,5"/><TextBlock Text="Hapus isi CD-RW atau DVD-RW pada drive yang dipilih." Style="{StaticResource Hint}"/><ComboBox x:Name="EraseDrivePicker" DisplayMemberPath="Name" Margin="0,12,0,8"/><Button Content="Hapus disc yang dapat ditulis ulang" HorizontalAlignment="Left" Click="Erase_Click"/><TextBlock Text="HY Burning Studio · Aplikasi offline untuk Windows" Style="{StaticResource Hint}" Margin="0,30,0,0"/></StackPanel></Border></Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HYBurningStudio</AssemblyName>
    <Version>0.3.0-beta</Version>
    <ApplicationIcon>Assets\HY-Burning-Studio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <None Update="NAudio-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\HY-Burning-Studio.ico" />
    <Resource Include="Assets\HY-Burning-Studio-Logo.png" />
  </ItemGroup>
</Project>
